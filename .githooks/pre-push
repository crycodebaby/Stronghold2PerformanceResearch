#!/bin/sh
# Run the docs linter for every pushed ref; it also requires a docs/STATE.md
# change in the pushed commits. Install: git config core.hooksPath .githooks
zero=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"     # new branch: commits not on any remote
    else
        range="$remote_sha..$local_sha"
    fi
    if ! python -I tools/lint_docs.py --range "$range"; then
        echo "pre-push: rejected $local_ref -> $remote_ref (fix the lint_docs errors above)." >&2
        status=1
    fi
done
exit $status
